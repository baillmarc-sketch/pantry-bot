# Mise — environment template. Copy to .env.local (git-ignored) for local dev,
# and set the same keys in Vercel project settings for production.
#
# RULE: anything WITHOUT the NEXT_PUBLIC_ prefix must never reach the browser
# bundle. Redact all of these from error output and logs.

# --- Firebase web config (client-safe) ---
# These are PUBLIC identifiers, not secrets. Security comes from Firestore rules
# + App Check, not from hiding these. Do not treat leaking them as an incident.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA v3 site key for Firebase App Check (also client-safe)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# --- Server-only secrets (NEVER prefixed NEXT_PUBLIC_, never in the bundle) ---
# Admin SDK service-account JSON (for server routes / blocking functions).
FIREBASE_SERVICE_ACCOUNT=
# Read ONLY inside app/api/ai/*. Set a spend cap on the Anthropic dashboard first.
ANTHROPIC_API_KEY=
# Comma-separated emails allowed to join the household (SSO allowlist).
HOUSEHOLD_ALLOWED_EMAILS=marc@example.com,anna@example.com
